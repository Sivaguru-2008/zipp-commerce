{
  "name": "zipp-commerce-backend",
  "version": "1.0.0",
  "description": "Zipp Commerce - Ultra-modern quick commerce platform backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seed.js",
    "indexes": "node utils/addIndexes.js",
    "preflight": "node utils/preflight.js",
    "lint:syntax": "node -e \"require('fs').readdirSync('.').filter(f=>f.endsWith('.js')).forEach(f=>require('child_process').execSync('node -c '+f))\"",
