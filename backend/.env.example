# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# trace | debug | info | warn | error — defaults: debug (dev), info (prod)
LOG_LEVEL=
# Number of proxy hops to trust (Render/Vercel/Cloudflare ≈ 1, double-proxy ≈ 2).
# Required for accurate rate-limit keying and req.ip behind a CDN.
TRUST_PROXY=1

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Atlas SRV format works directly: mongodb+srv://user:pass@cluster/zipp?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/zipp
# Pool size — tune for production traffic; defaults to 20 in prod, 10 in dev
MONGO_POOL_SIZE=

# ── Redis (cache + analytics + online users) ─────────────────────────────────
# Optional. When unset, the app degrades gracefully — caching becomes a no-op
# and analytics counters silently skip. Set in production for real perf wins.
REDIS_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Use: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_character_random_secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (optional — defaults to localhost variants)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
# Leave as-is to use local disk storage in development.
# Get credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Razorpay (payments) ───────────────────────────────────────────────────────
# Leave as-is to enable demo/test mode (no real charges).
# Get credentials at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Email (transactional mail) ────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Twilio (OTP / SMS) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Firebase (push notifications) ────────────────────────────────────────────
FIREBASE_SERVER_KEY=your_firebase_server_key

# ── Maps / Delivery ───────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPBOX_API_KEY=your_mapbox_api_key

# ── Logistics ─────────────────────────────────────────────────────────────────
SHIPROCKET_API_KEY=your_shiprocket_key
DELHIVERY_API_KEY=your_delhivery_key

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SESSION_SECRET=replace_with_random_secret

# ── AI (future) ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key
